# Immich API Key 所属用户的服务地址和 API Key
IMMICH_BASE_URL=http://127.0.0.1:2283
IMMICH_API_KEY=

# 视觉模型提供方：ollama 或 openai
VISION_PROVIDER=ollama

# Ollama（VISION_PROVIDER=ollama 时使用）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
# 单次推理的上下文窗口，图片较大或词表扩展时可提高到 16384
OLLAMA_CONTEXT_WINDOW=8192
# 每次推理后模型在 Ollama 中保持加载的时长
OLLAMA_KEEP_ALIVE=5m

# OpenAI 兼容接口（VISION_PROVIDER=openai 时使用）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# 可选批处理配置
PROCESSING_PAGE_SIZE=100
PROCESSING_MAX_RETRIES=3
PROCESSING_CONCURRENCY=2
PROCESSING_HTTP_TIMEOUT_SECONDS=30
PROCESSING_MODEL_TIMEOUT_SECONDS=300
# 每处理指定数量的图片后主动卸载模型，仅 Ollama 生效
PROCESSING_MODEL_RELEASE_INTERVAL=50
PROCESSING_CONNECT_TIMEOUT_SECONDS=5
PROCESSING_CONFIDENCE_THRESHOLD=0.65
PROCESSING_PROMPT_VERSION=v4
PROCESSING_STATE_FILE=.data/processing-state.jsonl
PROCESSING_FORCE=false
# 增量读取模式：复用相同 fileModifiedAt 图片的标签/相簿读取结果
PROCESSING_INCREMENTAL=true
PROCESSING_DRY_RUN=false
# PROCESSING_ASSET_ID=
# 跳过指定相簿中的图片，多个用英文逗号分隔，支持相簿名称或相簿 ID
# PROCESSING_SKIP_ALBUMS=
